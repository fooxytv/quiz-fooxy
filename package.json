{
  "name": "marvel-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marvel Wordle for team sprint reviews - server-authoritative, self-hosted",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "ADMIN_DEV_BYPASS=1 COOKIE_SECURE=false DATA_DIR=./data node --watch src/server.js",
    "test": "node test/smoke.mjs",
    "test:auth": "node test/login.mjs",
    "test:all": "node test/login.mjs && node test/smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
