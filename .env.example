# ---- public address -------------------------------------------------------
# Used for the QR code on the host screen. Must match the hostname you expose.
PUBLIC_URL=https://quiz.fooxy.tv

# ---- Cloudflare Access (protects /admin and /api/admin) -------------------
# Zero Trust > Settings > Custom Pages shows your team domain.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Zero Trust > Access > Applications > your app > Overview > Application Audience (AUD) Tag
CF_ACCESS_AUD=

# ---- gameplay -------------------------------------------------------------
# Starting per-word limit in ms for a brand new round. 0 disables it.
# Changeable live from the host portal: 0, 45000, 60000, 90000, 120000, 180000.
DEFAULT_LIMIT_MS=90000

# ---- misc -----------------------------------------------------------------
PORT=3000
DATA_DIR=/data
# Set to false only if you terminate on plain http (you shouldn't, behind a tunnel).
COOKIE_SECURE=true

# Local development only: lets loopback requests reach /admin with no Access JWT.
# Never set this in the deployed container.
# ADMIN_DEV_BYPASS=1
