# ---- Cloudflare Tunnel (required) -----------------------------------------
# Zero Trust > Networks > Tunnels > your tunnel > Install and run a connector.
# Copy the long token out of the shown command. Without this the quiz starts but
# nothing can reach it.
TUNNEL_TOKEN=

# ---- public address (required) --------------------------------------------
# The hostname you mapped in the tunnel. This is what the QR code encodes, so it
# must be exactly what a phone should open.
PUBLIC_URL=https://quiz.fooxy.tv

# ---- host password (required) ----------------------------------------------
# The quiz is open to anyone with the link; the host screen at /admin is not.
#
# Generate one that cannot be mangled by this file -- letters and digits only:
#
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 24; echo
#
# AVOID  #  $  "  '  and spaces. A '#' truncates the value at that point, a '$'
# can be expanded, quotes may be kept or stripped, and trailing spaces survive --
# all of which look exactly like "the password does not work". The server logs the
# length it actually received at startup; compare it with what you typed.
#
# After changing this: docker compose up -d   (the process reads it once, at start)
# Changing it also signs out every existing session.
#
# Leave it blank and /admin is SEALED -- players can play, you cannot host.
ADMIN_PASSWORD=

# How long a successful login lasts before asking again.
ADMIN_SESSION_DAYS=14

# ---- Cloudflare Access (optional alternative) ------------------------------
# Only if you run Zero Trust. Not needed when ADMIN_PASSWORD is set, and not
# available on every Cloudflare plan.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# ---- gameplay -------------------------------------------------------------
# Starting per-word limit in ms for a brand new round. 0 disables the limit.
# Changeable live from the host screen:
#   0, 45000, 60000, 90000, 120000, 180000, 240000, 300000
DEFAULT_LIMIT_MS=90000

# ---- misc -----------------------------------------------------------------
PORT=3000
DATA_DIR=/data
# Leave true. The tunnel terminates TLS, so browsers see https.
COOKIE_SECURE=true

# Do NOT set ADMIN_DEV_BYPASS or ADMIN_INSECURE_LOCAL here. They are local
# testing flags, and deploy.sh refuses to run if it finds either.
